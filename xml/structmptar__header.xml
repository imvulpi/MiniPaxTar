      <memberdef kind="variable" id="structmptar__header_1a28250e3fb7e47c83d9cfb134c65ffd0b" prot="public" static="no" mutable="no">
        <type>char</type>
        <definition>char mptar_header::checksum[8]</definition>
        <argsstring>[8]</argsstring>
        <name>checksum</name>
        <qualifiedname>mptar_header::checksum</qualifiedname>
        <briefdescription>
<para>Header checksum in octal ASCII. </para>
        </briefdescription>
        <detaileddescription>
<para><simplesect kind="note"><para>Calculated by treating these 8 bytes as ASCII spaces, summing all 512 bytes of the header as unsigned bytes, and storing the result as an octal string followed by a null and a space. Binary encoding is strictly forbidden here. </para>
</simplesect>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
        <location file="minipaxtar.h" line="600" column="10" bodyfile="minipaxtar.h" bodystart="600" bodyend="-1"/>
