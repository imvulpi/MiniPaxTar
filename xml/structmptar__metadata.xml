      <memberdef kind="variable" id="structmptar__metadata_1a8d433a8ab1f6605151b05599549e2505" prot="public" static="no" mutable="no">
        <type>char</type>
        <definition>char mptar_metadata::typeflag</definition>
        <argsstring></argsstring>
        <name>typeflag</name>
        <qualifiedname>mptar_metadata::typeflag</qualifiedname>
        <briefdescription>
<para>File entry type flag. </para>
        </briefdescription>
        <detaileddescription>
<para><simplesect kind="note"><para>Standard values include:<itemizedlist>
<listitem><para><computeroutput>&apos;0&apos;</computeroutput> or <computeroutput>&apos;\0&apos;</computeroutput>: Regular file - <ref refid="group__mptar__typeflags_1gga26733dab5e45235a0d51d0ae2055820fadb433a2bf48828256e9ecacc16595b91" kindref="member">MPTAR_FILE</ref> and <ref refid="group__mptar__typeflags_1gga26733dab5e45235a0d51d0ae2055820fa93f9224d8c8654b372e73269c8821bc4" kindref="member">MPTAR_FILE_LEGACY</ref></para>
</listitem><listitem><para><computeroutput>&apos;1&apos;</computeroutput>: Hard link - <ref refid="group__mptar__typeflags_1gga26733dab5e45235a0d51d0ae2055820fa7ad9100be15b262e61e00880e1751116" kindref="member">MPTAR_HARD_LINK</ref></para>
</listitem><listitem><para><computeroutput>&apos;2&apos;</computeroutput>: Symbolic link - <ref refid="group__mptar__typeflags_1gga26733dab5e45235a0d51d0ae2055820fa04edda73cb96bc8c638811c0e14c6f3b" kindref="member">MPTAR_SYMLINK</ref></para>
</listitem><listitem><para><computeroutput>&apos;3&apos;</computeroutput>: Character special file - <ref refid="group__mptar__typeflags_1gga26733dab5e45235a0d51d0ae2055820fa1cae5942ec834eedadba012194532498" kindref="member">MPTAR_CHAR_FILE</ref></para>
</listitem><listitem><para><computeroutput>&apos;4&apos;</computeroutput>: Block special file - <ref refid="group__mptar__typeflags_1gga26733dab5e45235a0d51d0ae2055820fa6688d925c3ec370e5c5e901d716fe6d3" kindref="member">MPTAR_BLOCK_FILE</ref></para>
</listitem><listitem><para><computeroutput>&apos;5&apos;</computeroutput>: Directory - <ref refid="group__mptar__typeflags_1gga26733dab5e45235a0d51d0ae2055820fac27611e80f93f28d6fd523770f472f79" kindref="member">MPTAR_DIRECTORY</ref></para>
</listitem><listitem><para><computeroutput>&apos;6&apos;</computeroutput>: FIFO / pipe - <ref refid="group__mptar__typeflags_1gga26733dab5e45235a0d51d0ae2055820fa4a05562af8e80d2403c55c67cf6ecb4e" kindref="member">MPTAR_PIPE</ref></para>
</listitem><listitem><para><computeroutput>&apos;7&apos;</computeroutput>: Contiguous file - <ref refid="group__mptar__typeflags_1gga26733dab5e45235a0d51d0ae2055820facfe35ec16403353afd1b613243d9c052" kindref="member">MPTAR_CONTINOUS_FILE</ref></para>
</listitem><listitem><para><computeroutput>&apos;x&apos;</computeroutput>: PAX extended header - <ref refid="group__mptar__typeflags_1gga26733dab5e45235a0d51d0ae2055820fabed31f90d02ee7a638b7d4fadb509eca" kindref="member">MPTAR_PAX_EX_HEADER</ref></para>
</listitem><listitem><para><computeroutput>&apos;g&apos;</computeroutput>: PAX global extended header - <ref refid="group__mptar__typeflags_1gga26733dab5e45235a0d51d0ae2055820fadc0494cca7e70a5bc4051e78d772e7e0" kindref="member">MPTAR_PAX_GLOBAL_EX_HEADER</ref></para>
</listitem></itemizedlist>
</para>
</simplesect>
See <ref refid="group__mptar__typeflags" kindref="compound">File Type Flags</ref> for defines of those. </para>
        </detaileddescription>
